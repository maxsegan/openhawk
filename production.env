# Switches of the authors' production runs (2026-10-12). Source before running the product
# runner to reproduce production behaviour:  set -a; . ./production.env; set +a
# Every switch has a rollback (unset, or the value named in the comment); code defaults are the
# rollbacks, so a run without this file is the older, more conservative pipeline.

# --- Output-defining switches -------------------------------------------------------------
TENNIS_BEST_EFFORT_TIER=on            # best-effort tier beside the validated flights (separate counts)
TENNIS_FIT_ONLY_BOUNCE_RULES=on       # demote flights whose fitted bounce no detector witnessed (off)
TENNIS_POST_FIT_CHECKS=on             # re-check the fitted point (grammar, net, reach, physics) (off)
TENNIS_PLAYER_POSE_3D=on              # pose step: 3D 17-joint skeletons for both players (off)
TENNIS_PORTAL_PLAYER_NAMES=on         # names from a match metadata table if present (off)
TENNIS_S6_GATE_RELEASE=on             # apply the policy's upstream gate releases (unset)
TENNIS_ACTIVE_PLAY_NO_RALLY_SCOPE=on  # clip without a rally span keeps its play shots (unset)
TENNIS_FLIGHT_PLAUSIBILITY=on         # two more post-validation reasons (speed, short serve) (unset)
TENNIS_FLIGHT_TRIM=on                 # trim a flight at its last supported frame (unset)
TENNIS_CAMERA_SHARED_CENTRE=on        # one camera centre per match (net-height bias down) (unset)
TENNIS_COURT_SIFT=cuda                # GPU court features (unset = CPU path)
TENNIS_COURT_SUPPORT=gpu
TENNIS_COURT_RANSAC=magsac
TENNIS_S6_LEAN=on                     # compact fit receipts (unset)

# --- Speed only (identical or near-identical outputs; need the matching GPU stack) ----------
TENNIS_PLAYER_DECODE=threads
TENNIS_BALL_SHARED_REFINE=1
TENNIS_RUNNER_CONCURRENT_POINT_FINDING=1
TENNIS_ACTIVE_PLAY_JOBS=12
TENNIS_CUDA_BLOCKING_SYNC=1
TENNIS_VIDEO_DECODE=nvdec             # NVDEC decoding (unset = ffmpeg on CPU)
TENNIS_COURT_DECODE=nvjpeg
TENNIS_EVENT_CROPS_DECODE=nvjpeg
TENNIS_MATH_THREADS=1
TENNIS_S6_STAGE_FORKSERVER=on
# TensorRT fp16 engines for the ball and player detectors (built on first use; torch fallback).
# Slightly different detections from torch (+2/-0 flights on a twin run).
TENNIS_BALL_ENGINE=trt_fp16
TENNIS_PLAYER_ENGINE=trt_fp16
# GPU S6 fitting (CUDA kernel built on first use; CPU fallback)
TENNIS_S6_GPU_FIT=on
